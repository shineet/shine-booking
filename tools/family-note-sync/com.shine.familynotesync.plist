<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the family note sync every 15 minutes.

  Install:
    cp com.shine.familynotesync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.shine.familynotesync.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.shine.familynotesync.plist

  NOTE ON PERMISSIONS: controlling Apple Notes needs Automation permission.
  macOS grants that to the app that asks, so run sync.py from Terminal by hand
  at least once first and approve the prompt. launchd runs under a different
  context and may need its own approval under System Settings, Privacy and
  Security, Automation. If scheduled runs do nothing while manual runs work,
  that is the cause. Check sync.err.log.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shine.familynotesync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/shinethankappan/Projects/shine-booking/tools/family-note-sync/sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/shinethankappan/Projects/shine-booking/tools/family-note-sync</string>

    <!-- Every 15 minutes. The note changes rarely; this is about a booked gig
         reaching the family list quickly enough to matter, not about being
         instant. -->
    <key>StartInterval</key>
    <integer>120</integer>

    <!-- Also run once when the Mac starts / the agent loads, so a gig booked
         while the machine was asleep lands as soon as it wakes. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/shinethankappan/Projects/shine-booking/tools/family-note-sync/sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shinethankappan/Projects/shine-booking/tools/family-note-sync/sync.err.log</string>
</dict>
</plist>
