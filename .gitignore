.vercel
.env*
node_modules

tools/family-note-sync/.env
tools/family-note-sync/*.log
tools/family-note-sync/__pycache__/

# Local-only backups. Never committed, so they never deploy as a second
# publicly reachable copy of a page that has eight people's plans on it.
*.html.bak

# Snapshots of trip data taken before a destructive edit. Local only: the
# repo root is served publicly, so a committed JSON of eight people's plans
# would be readable by anyone who guessed the filename.
trip-backups/
